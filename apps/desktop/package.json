{
  "name": "@clumsies/desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "bun run prepare:daemon && vite --host 127.0.0.1 --port 1420",
    "build": "APPLE_SIGNING_IDENTITY=- tauri build",
    "build:release": "tauri build --config src-tauri/tauri.release.conf.json",
    "build:web": "bun run prepare:daemon:release && tsc -p tsconfig.json --noEmit && vite build",
    "prepare:daemon": "bun scripts/prepare-daemon.ts",
    "prepare:daemon:release": "bun scripts/prepare-daemon.ts --release",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@clumsies/api-client": "workspace:*",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-updater": "~2",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.0.0"
  }
}

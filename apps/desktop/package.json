{
  "name": "@clumsies/desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLUMSIES_SERVER_URL=${CLUMSIES_SERVER_URL:-http://127.0.0.1:18080} tauri dev",
    "dev:web": "bun run prepare:daemon && vite --host 127.0.0.1 --port 1420",
    "build": "tauri build",
    "build:web": "bun run prepare:daemon:release && tsc -p tsconfig.json --noEmit && vite build",
    "prepare:daemon": "bun scripts/prepare-daemon.ts",
    "prepare:daemon:release": "bun scripts/prepare-daemon.ts --release",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@clumsies/api-client": "workspace:*",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@tauri-apps/api": "^2.11.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.0.0"
  }
}

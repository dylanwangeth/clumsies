{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clumsies",
  "version": "0.1.0",
  "identifier": "io.github.lilhammerfun.clumsies",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "beforeBuildCommand": "bun run build:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "clumsies",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/clumsiesd"]
  }
}

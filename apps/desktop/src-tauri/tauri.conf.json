{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clumsies",
  "mainBinaryName": "Clumsies",
  "version": "0.1.0",
  "identifier": "io.github.lilhammerfun.clumsies",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "beforeBuildCommand": "bun run build:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clumsies",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/clumsiesd"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1OTUwODkyOTIzMUVGMzgKUldRNDd6R1NrZ2lWeGIvL2F0T3RZa255WVFXVkRWRnhtdFdsUyswMXYxdkFvcHNTUVVvZWd1ckgK",
      "endpoints": [
        "https://github.com/lilhammerfun/clumsies/releases/latest/download/latest.json"
      ]
    }
  }
}
